# ==============================================================================
# Enterprise AI Research Agent Configuration (.env)
# Copy this file to .env at the repository root. Never commit the actual .env file.
# ==============================================================================

# --- AI Provider Selection ---
# Options: "bedrock" (default) | "openai_compatible"
AI_PROVIDER=bedrock

# --- Option 1: Amazon Bedrock / Mantle API Key (Recommended) ---
# If you have an Amazon Bedrock / Mantle API Key (starts with ABSK...):
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Or if using standard AWS IAM Credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional custom Mantle or VPC endpoint:
# BEDROCK_ENDPOINT_URL=https://your-custom-mantle-endpoint.aws

# --- Option 2: Universal OpenAI-Compatible Provider (MiniMax 2.5 / Kimi k2.5 / OpenRouter / Ollama) ---
# Set AI_PROVIDER=openai_compatible to activate
# AI_BASE_URL=https://api.minimax.chat/v1
# AI_MODEL=minimax-text-01
# AI_API_KEY=your_minimax_api_key

# --- Web Search & Source Discovery ---
TAVILY_API_KEY=

# --- Application & Storage ---
DATABASE_URL=sqlite:///./data/research_agent.db
ALLOWED_ORIGINS=http://localhost:5173
