# ==============================================================================
# Enterprise AI Research Agent Configuration (.env)
# Copy this file to .env at the repository root. Never commit the actual .env file.
# ==============================================================================

# --- AI Provider Selection ---
# Options: "bedrock" (default) | "openai_compatible"
AI_PROVIDER=bedrock

# --- Option 1: Amazon Bedrock (Recommended) ---
# If you have an Amazon Bedrock API Key or Bearer Token:
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
EMBEDDING_MODEL_ID=cohere.embed-english-v3.0

# Or if using standard AWS IAM Credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional custom Bedrock / Mantle endpoint:
# BEDROCK_ENDPOINT_URL=https://your-custom-endpoint.aws

# --- Option 2: Universal OpenAI-Compatible Provider (MiniMax / Groq / OpenRouter / Ollama) ---
# Set AI_PROVIDER=openai_compatible to activate
# AI_BASE_URL=https://api.minimax.chat/v1
# AI_MODEL=minimax-text-01
# AI_API_KEY=your_api_key

# --- Web Search & Source Discovery ---
TAVILY_API_KEY=

# --- Database & Storage (Supabase PostgreSQL 17 + pgvector) ---
# Transaction Pooler URL (Port 6543) for fast serverless/app query execution:
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# Direct Session URL (Port 5432) for migrations:
DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# --- CORS Settings ---
ALLOWED_ORIGINS=http://localhost:5173
