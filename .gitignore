# ==============================================================================
# Enterprise AI Research Agent - Git Ignore Rules
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
*.env
!*.env.example
.env.local
.env.development
.env.production
.env.test

# --- Databases, Data Dumps & Uploads ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
backend/data/
uploads/
**/uploads/
**/data/uploads/

# --- Personal & Non-Deployment Documents ---
*.pdf
*.docx
*.pptx
*.xlsx

# --- Python & Testing Caches ---
.venv/
venv/
ENV/
env/
backend/.packages/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
pytest-cache-files-*/
**/pytest-cache-files-*/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node & Frontend Build Artifacts ---
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
**/*.tsbuildinfo
.npm/
.pnpm-store/

# --- Temporary & Log Files ---
tmp/
temp/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE, OS & AI Tool Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
.gemini/
.agents/
.system_generated/

# --- Local-Only Architecture Documentation ---
FRONTEND_MAP.md
BACKEND_MAP.md
